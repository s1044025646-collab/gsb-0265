{
  "name": "vigenere-lab",
  "version": "1.0.0",
  "description": "维吉尼亚密码（经典加法型）编解码与候选密钥分析后端（API + CLI，教学用途）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "vigenere": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \"dist-test/test/crypto.test.js\" \"dist-test/test/frequency.test.js\" \"dist-test/test/lab.test.js\" \"dist-test/test/http.test.js\"",
    "start": "node --no-warnings dist/server.js",
    "demo": "node --no-warnings dist/cli/index.js demo",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('dist-test',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
